# 複製成 .env 後填入實際值：cp .env.example .env
# 所有設定都有預設值，但 DATABASE_URL / SECRET_KEY / OTP_PEPPER 上線前一定要換。

# ---- 應用 ----
APP_NAME=AgriPrice API
ENVIRONMENT=development          # development | staging | production
DEBUG=false
API_PREFIX=/v1
# 逗號分隔或 JSON 陣列都可以
CORS_ORIGINS=*

# ---- 資料庫 ----
# 一定要用 asyncpg driver
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- 安全性 ----
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# OTP 雜湊用的 pepper，與 SECRET_KEY 分開以便單獨輪替
OTP_PEPPER=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=60

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
# 開發用：把驗證碼直接回在 API response。ENVIRONMENT=production 時一律無效
OTP_DEBUG_ECHO=false

DEFAULT_COUNTRY_CODE=TW
DEFAULT_LOCALE=zh-Hant

# ---- 簡訊 ----
SMS_PROVIDER=console             # console | twilio
SMS_SENDER_ID=AgriPrice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- 報價 ----
QUOTE_DEFAULT_TTL_HOURS=48
QUOTE_MAX_ACTIVE_PER_USER=50

# ---- Demo 用的國家範圍 ----
# 讀取層過濾，不刪資料也不影響註冊。白名單優先，兩個都留空 = 不過濾。
# DEMO_VISIBLE_COUNTRIES=UG    # 只顯示烏干達
# DEMO_HIDDEN_COUNTRIES=TW     # 或只藏掉台灣
DEMO_VISIBLE_COUNTRIES=
DEMO_HIDDEN_COUNTRIES=

# ---- IP 反查位置 ----
# Cloud Phone 不支援 Geolocation API，「取得目前位置」靠 X-Forwarded-For 的 IP 反查。
# none = 關閉；ip_api = ip-api.com（免金鑰，但只有 HTTP，IP 會明文送出）
GEOIP_PROVIDER=ip_api
GEOIP_TIMEOUT=8

# ---- Extension ----
# 留空 = 載入 app/extensions/ 下全部；填了就只載入清單內的
EXTENSIONS_ENABLED=
EXTENSIONS_DISABLED=
# 各 extension 的私有設定，key = extension 的資料夾名稱。詳見 EXTENSIONS.md
EXTENSIONS_CONFIG={}
EXTENSION_HTTP_TIMEOUT=30
# 每幾筆寫入並提交一次。調小 = 更快落地、失敗損失更少；調大 = 吞吐較好
INGEST_BATCH_SIZE=500
EXTENSION_USER_AGENT=AgriPriceBot/0.1

# ---- 排程 ----
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Taipei
# 啟動時立即補跑一次所有來源
SCHEDULER_RUN_ON_STARTUP=false

# ---- 維運 ----
# /v1/admin/* 需要帶 X-Admin-Token。留空則管理端點一律拒絕
ADMIN_API_TOKEN=
LOG_LEVEL=INFO
LOG_JSON=false
